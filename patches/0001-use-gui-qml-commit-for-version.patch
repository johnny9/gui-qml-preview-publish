From: gui-qml preview publisher
Subject: [PATCH] qml: identify preview builds and disable the QML disk cache

Allow the publisher to inject the pinned gui-qml commit as the user-facing
version. Keep Bitcoin Core's own release and P2P version behavior unchanged
when the override is absent.

Preview executables replace the QML resources at the same qrc URLs on every
update. Do not let Qt reuse runtime-compiled QML units from an older preview;
they can contain an incompatible type graph and crash the QML compiler before
the window is created. Restrict this policy to builds carrying the publisher's
GUI_QML_BUILD_VERSION marker.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 288ef25..8c169b9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -33,6 +33,7 @@ find_package(Qt 6.2 MODULE REQUIRED
 find_package(QRencode MODULE REQUIRED)
 
 option(ENABLE_TEST_AUTOMATION "Enable test automation bridge for QML UI testing" OFF)
+set(GUI_QML_BUILD_VERSION "" CACHE STRING "Override the displayed gui-qml build version")
 
 # Do not build any executable targets from bitcoin submodule
 set(BUILD_BENCH OFF)
@@ -98,6 +99,9 @@ target_compile_definitions(bitcoinqml
     QT_NO_KEYWORDS
     QT_USE_QSTRINGBUILDER
 )
+if(GUI_QML_BUILD_VERSION)
+  target_compile_definitions(bitcoinqml PUBLIC GUI_QML_BUILD_VERSION="${GUI_QML_BUILD_VERSION}")
+endif()
 if(ENABLE_TEST_AUTOMATION)
   target_compile_definitions(bitcoinqml PUBLIC ENABLE_TEST_AUTOMATION)
 endif()
diff --git a/qml/bitcoin.cpp b/qml/bitcoin.cpp
--- a/qml/bitcoin.cpp
+++ b/qml/bitcoin.cpp
@@ -393,4 +393,8 @@ int QmlGuiMain(int argc, char* argv[])
 {
+#ifdef GUI_QML_BUILD_VERSION
+    qputenv("QML_DISABLE_DISK_CACHE", "1");
+#endif
+
 #ifdef WIN32
     common::WinCmdLineArgs winArgs;
     std::tie(argc, argv) = winArgs.get();
diff --git a/qml/models/nodemodel.h b/qml/models/nodemodel.h
index 7fdab7e..0c82bde 100644
--- a/qml/models/nodemodel.h
+++ b/qml/models/nodemodel.h
@@ -71,7 +71,14 @@ public:
 
     int blockTipHeight() const { return m_block_tip_height; }
     void setBlockTipHeight(int new_height);
-    QString fullClientVersion() const { return QString::fromStdString(FormatFullVersion()); }
+    QString fullClientVersion() const
+    {
+#ifdef GUI_QML_BUILD_VERSION
+        return QStringLiteral(GUI_QML_BUILD_VERSION);
+#else
+        return QString::fromStdString(FormatFullVersion());
+#endif
+    }
     int numPeers() const { return m_num_peers; }
     void setNumPeers(int new_num);
     int numInboundPeers() const { return m_num_inbound_peers; }
